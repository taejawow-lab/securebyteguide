---
import BaseLayout from '../layouts/BaseLayout.astro';
const standards = [
  { title: 'Sources', body: 'We prefer government and public-interest guidance, recognized standards, research, and official provider documentation that directly addresses the topic. Commercial pages may document product-specific behavior but are not independent proof of performance.' },
  { title: 'Experience claims', body: 'A comparison based on published documentation is labeled that way. We do not describe products, networks, or recovery procedures as tested, reviewed, or verified by us without retained evidence of that work.' },
  { title: 'Safety and uncertainty', body: 'Instructions identify important dependencies and situations where a reader should stop. Provider rules, software interfaces, laws, employer policies, and individual risks can change; current authoritative instructions take priority.' },
  { title: 'Affiliate relationships', body: 'A page containing an affiliate link carries a disclosure. A commission does not buy placement, and readers should compare current price, terms, privacy, support, and suitability themselves.' },
  { title: 'Corrections', body: 'Report an error or stale source to editor@securebyteguide.org with the article URL and the point in question. We review the cited material and update material guidance when warranted.' },
];
---
<BaseLayout title="Editorial Standards" description="Source, experience-claim, safety, affiliate, and corrections standards for SecureByteGuide">
  <article class="container mx-auto px-6 md:px-10 py-16 md:py-24">
    <header class="max-w-3xl mb-16"><p class="text-[10px] uppercase tracking-[0.25em] font-mono text-accent mb-4">¶ Standards</p><h1 class="text-6xl md:text-7xl font-bold leading-[0.95] mb-6" style="font-family:var(--font-display);">Editorial Standards</h1><p class="text-lg text-foreground/70">Use these statements to understand what our citations, comparisons, and limitations do—and do not—establish.</p></header>
    <div class="space-y-10">{standards.map((s,i)=><section class="grid grid-cols-12 gap-6 pb-10 border-b border-border"><p class="col-span-2 text-4xl font-bold text-accent">{String(i+1).padStart(2,'0')}</p><div class="col-span-10"><h2 class="text-3xl font-bold mb-3">{s.title}</h2><p class="text-[17px] leading-[1.7] text-foreground/75 max-w-3xl">{s.body}</p></div></section>)}</div>
  </article>
</BaseLayout>
