---
import BaseLayout from '../layouts/BaseLayout.astro';
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'SecureByteGuide';
const siteDescription = import.meta.env.PUBLIC_SITE_DESCRIPTION || 'Practical digital-safety guidance.';
---
<BaseLayout title="About" description={`About ${siteName}`}>
  <article class="container mx-auto px-6 md:px-10 py-16 md:py-24">
    <header class="max-w-3xl mb-14"><p class="text-[10px] uppercase tracking-[0.25em] font-mono text-accent mb-4">¶ About</p><h1 class="text-6xl md:text-7xl font-bold leading-[0.95] mb-6" style="font-family:var(--font-display);">About {siteName}</h1><p class="text-lg text-foreground/70">{siteDescription}</p></header>
    <div class="prose-article max-w-3xl space-y-8 text-[17px] leading-[1.7]">
      <section><h2>Editorial mission</h2><p>{siteName} publishes practical digital-safety guides for account protection, home networks, privacy, backups, phishing, and recovery. Articles summarize cited public guidance and explain where provider-specific instructions or professional help take priority. We do not present product use or laboratory testing as first-hand experience unless an article explicitly documents that evidence.</p></section>
      <section><h2>How to read the guides</h2><ul><li><strong>Evidence in context:</strong> comparisons identify the sources and limits relevant to the decision.</li><li><strong>No sponsored placement:</strong> payment cannot buy a recommendation; applicable affiliate relationships are disclosed.</li><li><strong>Transparency:</strong> AI tools may assist drafting; citations remain available for readers to inspect.</li><li><strong>Corrections:</strong> readers can report a broken link, factual error, or unclear limitation.</li></ul></section>
      <section><h2>Contact</h2><p>Corrections, tips, and partnership questions: <a href="mailto:editor@securebyteguide.org">editor@securebyteguide.org</a>.</p></section>
    </div>
  </article>
</BaseLayout>
