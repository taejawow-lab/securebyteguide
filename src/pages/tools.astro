---
import BaseLayout from '../layouts/BaseLayout.astro';
const items=[['Password manager','Use a dedicated password manager for important accounts',18],['Email MFA','Protect email with app-based MFA or a passkey',20],['Device updates','Enable automatic OS/browser updates',14],['Backups','Keep a tested backup for photos and documents',14],['Recovery plan','Record account recovery options and backup codes safely',16],['Phishing drill','Practice checking sender, domain, and login URL',10],['Router basics','Change default router password and enable guest Wi‑Fi',8]];
---
<BaseLayout title="Security Tools" description="Free client-side security score and password strength checks for SecureByte Guide readers."><section class="wrap py-16 md:py-24"><p class="kicker">Live tools</p><h1 class="mt-5 max-w-3xl text-5xl md:text-7xl">Check the basics before something goes wrong.</h1><p class="mt-6 max-w-2xl text-xl text-[var(--ink-2)]">This lightweight security score runs only in your browser. It saves progress locally as <code>sbg-score</code>.</p><div class="mt-10 grid gap-8 lg:grid-cols-[220px_1fr]"><aside class="card p-6"><div class="score-big" id="score-ring" style="--score:0%"><span id="score-label">0</span></div><p class="mt-5 text-sm text-[var(--ink-3)]">Weighted against account recovery, MFA, backup, device, and phishing basics.</p></aside><div class="tool-grid">{items.map(([label,text,weight],i)=><label class="tool-card card flex items-start gap-4"><input type="checkbox" data-check={i} data-weight={weight} class="mt-1 h-5 w-5 accent-[var(--accent)]"/><span><strong>{label}</strong><br/><small class="text-[var(--ink-2)]">{text}</small></span></label>)}</div></div><div class="card mt-10 p-6"><h2 class="text-2xl">Password quick check</h2><p class="text-[var(--ink-2)]">Nothing is sent anywhere. The meter only checks length and character variety.</p><input id="pw" type="password" class="mt-4 w-full rounded-[var(--r-sm)] border bg-[var(--surface-2)] p-3" style="border-color:var(--line);" placeholder="Type a sample password"/><div class="mt-3 h-3 rounded-full bg-[var(--bg-tint)]"><div id="pwbar" class="h-3 rounded-full bg-[var(--accent)]" style="width:0%"></div></div><p id="pwmsg" class="mono mt-2 text-sm text-[var(--ink-3)]">Score: 0/100</p></div></section><script is:inline>(()=>{const key='sbg-score';const boxes=[...document.querySelectorAll('[data-check]')];const saved=JSON.parse(localStorage.getItem(key)||'[]');boxes.forEach((b,i)=>b.checked=!!saved[i]);function upd(){const vals=boxes.map(b=>b.checked);localStorage.setItem(key,JSON.stringify(vals));const score=boxes.reduce((n,b)=>n+(b.checked?Number(b.dataset.weight):0),0);document.getElementById('score-label').textContent=score;document.getElementById('score-ring').style.setProperty('--score',score+'%');}boxes.forEach(b=>b.addEventListener('change',upd));upd();const pw=document.getElementById('pw'),bar=document.getElementById('pwbar'),msg=document.getElementById('pwmsg');pw?.addEventListener('input',()=>{const v=pw.value;let s=Math.min(45,v.length*4)+( /[A-Z]/.test(v)?12:0)+( /[a-z]/.test(v)?8:0)+( /\d/.test(v)?12:0)+( /[^A-Za-z0-9]/.test(v)?18:0);s=Math.min(100,s);bar.style.width=s+'%';msg.textContent='Score: '+s+'/100';});})();</script></BaseLayout>
