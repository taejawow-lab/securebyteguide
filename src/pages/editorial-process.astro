---
import BaseLayout from '../layouts/BaseLayout.astro';
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'SecureByteGuide';
const steps = [
  { n: '01', title: 'Define the reader decision', body: 'A guide starts with a specific security or recovery problem, the people affected, and conditions that require provider support, an administrator, emergency services, or another qualified professional.' },
  { n: '02', title: 'Use attributable evidence', body: 'Articles link relevant government guidance, standards, research, and official provider documentation. A reference list supports checking; a citation does not make every statement universally applicable.' },
  { n: '03', title: 'Separate evidence from judgment', body: 'Documented product behavior and public guidance are distinguished from examples, calculations, and editorial recommendations. We do not claim first-hand tests or ownership without records that support the claim.' },
  { n: '04', title: 'Give limits and stop rules', body: 'Security instructions include recovery dependencies, privacy cautions, and escalation points. Readers should prefer current official instructions when a menu, policy, law, or account state differs.' },
  { n: '05', title: 'Accept corrections', body: 'Readers may report factual errors, stale links, or unclear wording to editor@securebyteguide.org. Material corrections should update the article date or explain the changed guidance.' },
];
---
<BaseLayout title="Editorial Process" description={`How ${siteName} approaches digital-safety guidance`}>
  <article class="container mx-auto px-6 md:px-10 py-16 md:py-24">
    <header class="max-w-3xl mb-16"><p class="text-[10px] uppercase tracking-[0.25em] font-mono text-accent mb-4">¶ Editorial method</p><h1 class="text-6xl md:text-7xl font-bold leading-[0.95] mb-6" style="font-family:var(--font-display);">Editorial Process</h1><p class="text-lg text-foreground/70">These standards describe how readers should interpret our guides and sources. They are not a claim that a checklist can eliminate risk.</p></header>
    <div class="space-y-12">{steps.map((s)=><section class="grid grid-cols-12 gap-6 pb-12 border-b border-border"><p class="col-span-2 text-5xl font-bold text-accent">{s.n}</p><div class="col-span-10"><h2 class="text-3xl font-bold mb-3">{s.title}</h2><p class="text-[17px] leading-[1.7] text-foreground/75 max-w-3xl">{s.body}</p></div></section>)}</div>
  </article>
</BaseLayout>
