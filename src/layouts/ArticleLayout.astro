---
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import References from '../components/References.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  category?: string;
  sources?: Array<{ title: string; url: string; author?: string; year?: string }>;
  affiliate?: boolean;
  visualsCount?: number;
  hasVideo?: boolean;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  faq?: Array<{ question: string; answer: string }>;
  internalLinks?: string[];
  takeaways?: string[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  category,
  sources = [],
  affiliate = false,
  visualsCount = 0,
  hasVideo = false,
  headings = [],
  faq = [],
  internalLinks = [],
  takeaways = [
    'Use source-backed steps before changing security settings.',
    'Prioritize MFA, updates, backups, segmentation, and phishing-resistant habits.',
    'Save only the guides you need; no account is required.',
  ],
} = Astro.props;

const articleSchema = {
  '@type': 'Article',
  headline: title,
  description,
  image: heroImage,
  datePublished: pubDate?.toISOString(),
  dateModified: (updatedDate || pubDate)?.toISOString(),
  author: {
    '@type': 'Organization',
    name: import.meta.env.PUBLIC_SITE_NAME + ' Editorial Team',
    url: import.meta.env.PUBLIC_SITE_URL,
  },
  publisher: {
    '@type': 'NewsMediaOrganization',
    name: import.meta.env.PUBLIC_SITE_NAME,
    url: import.meta.env.PUBLIC_SITE_URL,
  },
};

const faqSchema = faq.length > 0 ? {
  '@type': 'FAQPage',
  mainEntity: faq.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: q.answer },
  })),
} : null;

const siteUrlBC = (Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'https://securebyteguide.org'));
const siteNameBC = import.meta.env.PUBLIC_SITE_NAME || 'Editorial';
const postUrlBC = `${siteUrlBC}${Astro.url.pathname}`;
const categorySlug = category ? category.toLowerCase().trim().replace(/\s+/g, '-') : '';
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: siteNameBC, item: `${siteUrlBC}/` },
    ...(category ? [{ '@type': 'ListItem', position: 2, name: category, item: `${siteUrlBC}/category/${categorySlug}/` }] : []),
    { '@type': 'ListItem', position: (category ? 3 : 2), name: title, item: postUrlBC },
  ],
};

const schema = faqSchema ? {
  '@context': 'https://schema.org',
  '@graph': [articleSchema, breadcrumbSchema, faqSchema],
} : { '@context': 'https://schema.org', '@graph': [articleSchema, breadcrumbSchema] };

const lang = import.meta.env.PUBLIC_SITE_LANG || 'en';
const localeMap: Record<string, string> = { ko: 'ko-KR', ja: 'ja-JP', en: 'en-US' };
const tMap: Record<string, { published: string; updated: string; sources: string; visuals: string; video: string; related: string; explore: string }> = {
  ko: { published: 'Published', updated: 'Updated', sources: 'sources cited', visuals: 'visuals', video: 'Video summary', related: 'Related Reading', explore: 'Open related path' },
  ja: { published: '公開', updated: '更新', sources: '件の出典', visuals: '点のビジュアル', video: '動画要約', related: 'あわせて読みたい', explore: '関連ページを開く' },
  en: { published: 'Published', updated: 'Updated', sources: 'sources cited', visuals: 'visuals', video: 'Video summary', related: 'Related Reading', explore: 'Open related path' },
};
const t = tMap[lang] || tMap.en;
const locale = localeMap[lang] || 'en-US';
const validInternalLinks = internalLinks.filter((link) => link && link !== '/' && link !== Astro.url.pathname);
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  publishedTime={pubDate?.toISOString()}
  modifiedTime={(updatedDate || pubDate)?.toISOString()}
  schema={schema}
>
  <div class="progress-wrap" aria-hidden="true"><div id="reading-progress" class="progress-bar"></div></div>
  <article>
    <header class="article-hero"><div class="wrap"><div class="mb-4 flex items-center gap-3 text-sm text-[var(--ink-3)]"><a href="/posts/">Guides</a><span>›</span>{category && <a href={`/category/${categorySlug}/`}>{category}</a>}</div>{category && <p class="kicker">{category}</p>}<h1 class="article-title mt-5">{title}</h1><p class="article-dek mt-5">{description}</p><div class="meta-rail"><span>↻ {t.updated} {(updatedDate||pubDate)?.toLocaleDateString(locale,{month:'long',year:'numeric'})}</span><span>{sources.length} {t.sources}</span>{sources.slice(0,3).map((s)=><span class="src-chip">{s.title.split(' ')[0]}</span>)}</div></div></header>
    {heroImage && <div class="wrap mt-10"><div class="guide-art h-auto aspect-[16/7]"><img src={heroImage} alt={title} width="1280" height="720" loading="eager" fetchpriority="high" decoding="async" class="h-full w-full rounded-[var(--r-md)] object-cover opacity-40 mix-blend-multiply" /></div></div>}
    {affiliate && <div class="wrap mt-6"><AffiliateDisclosure /></div>}
    <script is:inline>(()=>{const bar=document.getElementById('reading-progress');const set=()=>{const max=document.documentElement.scrollHeight-innerHeight;if(bar&&max>0)bar.style.width=Math.min(100,Math.max(0,scrollY/max*100))+'%'};addEventListener('scroll',set,{passive:true});set();document.addEventListener('click',e=>{if(e.target.closest('[data-copy-link]'))navigator.clipboard?.writeText(location.href)})})();</script>
    <div class="wrap article-shell">
      {headings.length>0 && <aside class="toc-card"><p class="kicker !text-[10px] mb-3">On this page</p><TOC headings={headings}/><a href="/tools/" class="btn btn-ghost">Check my security</a></aside>}
      <div class="prose-article min-w-0"><div class="takeaways"><strong class="flex items-center gap-2 text-[var(--ink)]">◎ Key takeaways</strong><ul>{takeaways.map((item) => <li>{item}</li>)}</ul></div><slot />{sources.length>0 && <References sources={sources}/>}</div>
      <aside class="side-actions hidden lg:block"><div class="sticky top-28 flex flex-col gap-3"><button data-bookmark data-title={title} data-url={Astro.url.pathname} class="icon-btn">☆</button><button data-copy-link class="icon-btn">↗</button></div></aside>
    </div>
    {validInternalLinks.length>0 && <section class="wrap mt-14"><div class="card p-6"><h2 class="mb-5 text-2xl">{t.related}</h2><ul class="grid gap-3 sm:grid-cols-2">{validInternalLinks.map((link)=><li><a href={link} class="btn btn-ghost w-full justify-between"><span class="truncate">{link}</span><span>→</span></a></li>)}</ul></div></section>}
    {tags.length>0 && <footer class="wrap mt-12 border-t pt-8" style="border-color:var(--line);"><div class="flex flex-wrap gap-2">{tags.map((tag)=><a href={`/tags/${tag.toLowerCase().trim().replace(/[\/\\&%?#=]/g, '-').replace(/\s+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '')}/`} class="src-chip">#{tag}</a>)}</div></footer>}
  </article>
</BaseLayout>
