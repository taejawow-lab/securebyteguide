---
import ThemeToggle from './ThemeToggle.astro';
import SecureMark from './SecureMark.astro';
const navItems=[{label:'Guides',href:'/posts/'},{label:'Tools',href:'/tools/'},{label:'Topics',href:'/categories/'},{label:'Search',href:'/search/'}];
---
<header class="site-nav"><div class="wrap flex min-h-[var(--nav-h)] items-center justify-between gap-5"><a href="/" class="flex min-w-0 items-center gap-3" aria-label="SecureByte Guide home"><span class="text-[var(--ink)]"><SecureMark class="h-9 w-9" /></span><span class="min-w-0"><span class="brand-word block text-xl leading-none">SecureByte <span class="text-[var(--accent)]">Guide</span></span><span class="brand-sub hidden sm:block">Practical digital safety</span></span></a><nav class="hidden md:block" aria-label="Primary navigation"><ul class="flex items-center gap-8 font-semibold text-[var(--ink-2)]">{navItems.map((item)=><li><a href={item.href} class="hover:text-[var(--accent)]">{item.label}</a></li>)}</ul></nav><div class="flex items-center gap-2"><a href="/search/" class="hidden sm:inline-flex h-10 min-w-[150px] items-center gap-2 rounded-[var(--r-sm)] border px-4 text-sm text-[var(--ink-3)]" style="border-color:var(--line);background:var(--surface);">⌕ Search</a><ThemeToggle/><a href="/tools/" class="btn btn-primary hidden sm:inline-flex min-h-10">Check my security</a></div></div><nav class="border-t md:hidden" style="border-color:var(--line);"><ul class="wrap flex gap-2 overflow-x-auto py-2 text-sm font-semibold">{navItems.map((item)=><li class="shrink-0"><a href={item.href} class="inline-flex min-h-10 items-center rounded-full border px-4" style="border-color:var(--line);background:var(--surface);">{item.label}</a></li>)}</ul></nav></header>
