---
import SecureMark from './SecureMark.astro';
export interface Props{title:string;description:string;href:string;image?:string;category?:string;pubDate:Date;readingTime?:number;variant?:'feature'|'standard'|'row';index?:number;}
const {title,description,href,image,category='Security',pubDate,readingTime=7,variant='standard',index=0}=Astro.props;
const url=href.endsWith('/')?href:`${href}/`; const date=pubDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
---
{variant==='row'?<article class="row-card"><div class="row-icon"><SecureMark class="h-7 w-7" /></div><a href={url} class="min-w-0"><p class="kicker !text-[10px]">{category}</p><h3>{title}</h3><p class="line-clamp-2 text-sm text-[var(--ink-2)]">{description}</p></a><div class="meta hidden sm:flex mono text-xs text-[var(--ink-3)]"><span>{date}</span><span>·</span><span>{readingTime} min</span></div></article>:<article class="guide-card card"><a href={url} class="block"><div class="guide-art">{image?<img src={image} alt={title} class="h-full w-full rounded-[var(--r-md)] object-cover opacity-45 mix-blend-multiply" loading="lazy" decoding="async"/>:<SecureMark class="h-14 w-14"/>}</div><p class="kicker !text-[10px]">{category}</p><h3>{title}</h3><p class="line-clamp-3">{description}</p><div class="mt-5 flex items-center justify-between border-t pt-4 mono text-xs text-[var(--ink-3)]" style="border-color:var(--line);"><span>{date}</span><span>{readingTime} min →</span></div></a></article>}
