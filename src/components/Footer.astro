---
import SecureMark from './SecureMark.astro';
const year=new Date().getFullYear();
const followLinks=[{label:'Pinterest',href:import.meta.env.PUBLIC_SITE_PINTEREST},{label:'Instagram',href:import.meta.env.PUBLIC_SITE_INSTAGRAM},{label:'YouTube',href:import.meta.env.PUBLIC_SITE_YOUTUBE}].filter(x=>x.href);
---
<footer class="mt-24 border-t" style="border-color:var(--line);background:var(--surface);"><div class="wrap py-16"><div class="footer-grid"><div><div class="mb-4 flex items-center gap-3"><SecureMark class="h-11 w-11"/><h2 class="brand-word text-3xl">SecureByte <span class="text-[var(--accent)]">Guide</span></h2></div><p class="max-w-sm text-[var(--ink-2)]">Practical digital safety for accounts, devices, privacy, and recovery — every guide traced to named public-interest sources.</p><div class="mt-6 flex flex-wrap gap-2"><span class="src-chip">FTC</span><span class="src-chip">CISA</span><span class="src-chip">NIST</span><span class="src-chip">Mozilla</span></div></div><div class="grid grid-cols-2 gap-8 md:grid-cols-4"><div><h4 class="kicker mb-4">Sections</h4><ul class="space-y-3 text-sm text-[var(--ink-2)]"><li><a href="/">Home</a></li><li><a href="/posts/">Guides</a></li><li><a href="/categories/">Topics</a></li><li><a href="/tools/">Tools</a></li><li><a href="/search/">Search</a></li></ul></div><div><h4 class="kicker mb-4">Editorial</h4><ul class="space-y-3 text-sm text-[var(--ink-2)]"><li><a href="/about/">About</a></li><li><a href="/editorial-process/">Process</a></li><li><a href="/editorial-standards/">Standards</a></li><li><a href="/contact/">Contact</a></li></ul></div><div><h4 class="kicker mb-4">Legal</h4><ul class="space-y-3 text-sm text-[var(--ink-2)]"><li><a href="/privacy/">Privacy</a></li><li><a href="/terms/">Terms</a></li><li><a href="/cookie-policy/">Cookie</a></li><li><a href="/disclaimer/">Disclaimer</a></li><li><a href="/affiliate-disclosure/">Affiliate</a></li></ul></div><div><h4 class="kicker mb-4">Follow</h4>{followLinks.length ? <ul class="space-y-3 text-sm text-[var(--ink-2)]">{followLinks.map((item)=><li><a href={item.href}>{item.label} →</a></li>)}</ul> : <p class="text-sm leading-7 text-[var(--ink-2)]">Social channels will be linked after launch. Corrections go through Contact.</p>}</div></div></div><p class="mt-10 text-sm text-[var(--ink-2)]">As an Amazon Associate I earn from qualifying purchases.</p><div class="mt-12 border-t pt-6 text-xs leading-7 text-[var(--ink-3)]" style="border-color:var(--line);"><p>Content is produced with AI assistance and checked against public-interest sources. No security tool on this site sends entered data to a server.</p><p class="mt-2">© {year} SecureByte Guide · All rights reserved · Built with Astro</p></div></div></footer>
