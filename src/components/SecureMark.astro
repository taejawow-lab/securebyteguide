---
export interface Props { class?: string; }
const { class: className='h-8 w-8' } = Astro.props;
---
<svg class:list={[className,'brandmark']} viewBox="0 0 40 40" fill="none" aria-hidden="true">
  <path d="M20 3.5l13 4.6v8.4c0 8.7-5.6 14.2-13 16.8C12.6 30.7 7 25.2 7 16.5V8.1L20 3.5z" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round"/>
