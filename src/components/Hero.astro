---
export interface Props { featured?: any; postCount?: number; }
const { featured, postCount=39 }=Astro.props;
---
<section class="hero-security"><div class="wrap hero-grid"><div><p class="kicker">Digital safety, without the jargon</p><h1 class="hero-title mt-7">Protect your accounts <em>before</em> something goes wrong.</h1><p class="hero-dek">Clear, source-backed guides and free tools for passwords, two-factor login, privacy, backup, and account recovery. Built for real people — every recommendation traced to FTC, CISA, NIST and other public-interest sources.</p><div class="flex flex-wrap gap-3"><a href="/tools/" class="btn btn-primary">Check my security</a><a href={featured ? `/posts/${featured.slug}/` : '/posts/'} class="btn btn-ghost">Browse the guides →</a></div><div class="hero-trust"><span>✓ No account needed</span><span>◎ No tracking</span><span>◌ Free & open</span><span>{postCount} preserved guides</span></div></div><aside class="score-panel"><div class="flex items-center justify-between"><p class="kicker">Security score</p><span class="src-chip">Live tool</span></div><div class="score-ring"><span>72<small class="block text-sm font-normal text-[var(--ink-3)]">/100</small></span></div><div><p class="check-row"><b>✓</b>Password manager in use</p><p class="check-row"><b>✓</b>Email protected with MFA</p><p class="check-row"><b>✓</b>Automatic device backups</p><p class="check-row"><b style="background:var(--warn-soft);color:var(--warn)">＋</b>Recovery plan documented</p></div><a class="btn btn-accent mt-4 w-full" href="/tools/">Get your score →</a></aside></div></section>
